# --- App ---
APP_NAME=backend
ENV=dev
DEBUG=True
API_V1_PREFIX=/api/v1

# --- Security ---
JWT_SECRET=change_me_please_very_long_random_string
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# SQLite local (default)
DATABASE_URL=sqlite:///./app.db

# Azure MySQL (ejemplo)
# DATABASE_URL=mysql+pymysql://username:password@host:3306/dbname

# Azure SQL (ejemplo)
# DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net:1433/dbname?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
