# App Configuration
APP_NAME=backend
ENV=dev
DEBUG=True
API_V1_PREFIX=/api/v1

# Database (local SQLite for dev)
DATABASE_URL=sqlite:///./app.db

# JWT (for local dev — change in production!)
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=./rdma-una-firebase-adminsdk-fbsvc-f77993d0a9.json

# Azure Storage (optional, leave blank if not set up yet)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER_DOCUMENTS=documents
AZURE_BLOB_CONTAINER_IMAGES=images
AZURE_BLOB_CONTAINER_VECTORIZED=vectorized-documents
MAX_UPLOAD_SIZE_MB=50

# Azure OpenAI Embeddings (optional)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Qdrant Vector DB (optional)
# QDRANT_ENDPOINT=
# QDRANT_API_KEY=
QDRANT_RESEARCH_COLLECTION=research-embeddings
QDRANT_TIMEOUT_SECONDS=30

# SQL Server (optional — leave blank to use SQLite)
# SQLSERVER_HOST=
# SQLSERVER_PORT=1433
# SQLSERVER_DB=
# SQLSERVER_USER=
# SQLSERVER_PASSWORD=
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# SQLSERVER_TIMEOUT=
ALLOW_ORIGINS=